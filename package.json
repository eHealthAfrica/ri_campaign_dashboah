{
  "name": "ri-campaign-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build && node scripts/gzip-dist.mjs",
    "start": "node server/index.mjs",
    "add-user": "node scripts/add-user.mjs",
    "test": "node --test server/app.test.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
